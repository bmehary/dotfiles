#!/bin/bash


DOTFILES_DIR="${DOTFILES:-$HOME/.dotfiles}"
SSH_DIR="$HOME/.ssh"

usage() {
  cat <<EOF
Usage: $(basename "${BASH_SOURCE[0]}") [-h] [-v] <sub-command>

Script the creation of a new worktree.

Available options:

-h, --help                    Print this help and exit
-v, --verbose                 Print script debug info

Subcommands:
stow                          Run GNU Stow
EOF
  exit
}

die() {
  local msg=$1
  local code=${2-1} # default exit status 1
  echo "$msg"
  exit "$code"
}

_validate_script_location() {
  # Ensure script is located within the dotfiles directory 
  [[ !"${BASH_SOURCE[0]}" =~ "$DOTFILES_DIR" ]] || die "Script must be located within: $DOTFILES_DIR"
}

_run_stow() {
  # Stow commands: https://www.gnu.org/software/stow/manual/html_node/Invoking-Stow.html
  # Notes:
  #  -v : verbose
  #  -n : dry-run
  #  -R : restow
  #  -D : unstow

  input_params="$@" 

  # Change to dotfiles directory 
  cd "$DOTFILES_DIR" || die "Could not change directory to $DOTFILES_DIR"

  EXCLUDE="ansible bin scripts vscode"
  PACKAGES_TO_STOW=()
  for pkg in */; do
    # Remove the trailing slash for the directory name
    PACKAGE_NAME=${pkg%/}

    if [[ " $EXCLUDE " =~ " $PACKAGE_NAME " ]]; then
      echo "Skipping excluded package: $PACKAGE_NAME"
      continue
    fi

    PACKAGES_TO_STOW+=("$PACKAGE_NAME")
  done

  # Check if the array is empty before calling stow
  if [ ${#PACKAGES_TO_STOW[@]} -eq 0 ]; then
    echo "Nothing to stow. Exiting."
  else
    echo "Packages to stow: ${PACKAGES_TO_STOW[*]}"
    stow ${input_params:+"$input_params"} "${PACKAGES_TO_STOW[@]}" 
  fi

  cd - >/dev/null || die "Could not change back to previous directory"

  echo "Stow Complete"
}

_validate_script_location

while [[ "$#" -gt 0 ]]; do
  case "${1-}" in
    -h|--help) usage ;;
    -v|--verbose) set -x ;;
    stow) shift; _run_stow "$@"; exit ;;
    -*) die "Error: Unknown option ${1-}" ;;
    *) POSITIONAL_ARGS+=("${1-}") ;;
  esac
  shift
done

detect_os() {
  if [ -f /etc/os-release ]; then
    source /etc/os-release
    echo $ID
  else
    echo $(uname -s | tr '[:upper:]' '[:lower:]')
  fi
}

function macos_setup() {
  if ! [ -x "$(command -v brew)" ]; then
    echo "Installing Homebrew"
    /bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"
  fi
  if ! [ -x "$(command -v ansible)" ]; then
    echo "Installing Ansible"
    _cmd "brew install ansible"
  fi
  if ! [ -x "$(command -v git)" ]; then
    echo "Installing Git"
    _cmd "brew install git"
  fi
}

function ubuntu_setup() {
    echo "ubuntu setup...do nothing"
}

function arch_setup() {
    echo "arch setup...do nothing"
}

dotfiles_os=$(detect_os)
echo "Loading Setup for detected OS: $dotfiles_os"
case $dotfiles_os in
  ubuntu)
    ubuntu_setup
    ;;
  arch)
    arch_setup
    ;;
  darwin)
    macos_setup
    ;;
  *)
    echo 'Unsupported OS'
    ;;
esac

# Generate SSH keys
if ! [[ -f "$SSH_DIR/authorized_keys" ]]; then
  mkdir -p "$SSH_DIR"
  chmod 700 "$SSH_DIR"

  ssh-keygen -t ed25519 -f "$SSH_DIR/id_ed25519" -N "" -C "$USER@$HOSTNAME"

  cat "$SSH_DIR/id_ed25519.pub" >> "$SSH_DIR/authorized_keys"
  chmod 600 "$SSH_DIR/authorized_keys"
fi

if ! [ -x "$(command -v ansible)" ]; then
    echo "Ansible not found. Please install manually."
    exit 1
fi

echo "Running ansible playbook"

ANSIBLE_DIR="$DOTFILES_DIR/ansible"
ANSIBLE_MAIN_PATH=${ANSIBLE_DIR}/main.yml
ANSIBLE_CONFIG_PATH=${ANSIBLE_DIR}/ansible.cfg
ANSIBLE_REQ_PATH=${ANSIBLE_DIR}/requirements/common.yml

ANSIBLE_CONFIG=$ANSIBLE_CONFIG_PATH ansible-galaxy install -r $ANSIBLE_REQ_PATH
ANSIBLE_CONFIG=$ANSIBLE_CONFIG_PATH ansible-playbook $ANSIBLE_MAIN_PATH "$@"

