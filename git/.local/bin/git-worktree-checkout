#!/bin/bash

set -Eeuo pipefail

# Reference: https://github.com/nicknisi/dotfiles/blob/main/bin/git-create-worktree


## Use Cases:
# 1. Create a new worktree based on local branch
#    git wtco <worktree-path> <branch> -b <local-base-branch>
# 2. Create a new worktree based on remote branch
#    git wtco <worktree-path> <branch> -b origin/<remote-base-branch>
# 3. Create a new worktree and branch based on main
#    git wtco <worktree-path> <branch>
# 4. Create a new worktree and branch based on specific commit
#    git wtco <worktree-path> <branch> -b <commit-ish>

# Note: Try to just use 'git wta' 

usage() {
  cat <<EOF
Usage: $(basename "${BASH_SOURCE[0]}") [-h] [-v] [-b] <worktree-path> <branch>

Script the creation of a new worktree.

Available options:

-h, --help                    Print this help and exit
-v, --verbose                 Print script debug info
-b, --base                    The branch or commit-ish to use as the base for the new worktree (default: main)
EOF
  exit
}

die() {
  local msg=$1
  local code=${2-1} # default exit status 1
  echo "$msg"
  exit "$code"
}


# Default values
base=''

while [[ "$#" -gt 0 ]]; do
  case "${1-}" in
    -h|--help) usage ;;
    -v|--verbose) set -x ;;
    -b|--base) base="${2-}"; shift ;;
    -*) die "Error: Unknown option ${1-}" ;;
    *) POSITIONAL_ARGS+=("${1-}") ;;
  esac
  shift
done

# check required params and arguments
[[ ${#POSITIONAL_ARGS[@]} -lt 2 ]] && die "Too few script arguments"
[[ ${#POSITIONAL_ARGS[@]} -gt 2 ]] && die "Too many script arguments"

set -- "${POSITIONAL_ARGS[@]}"
args=("$@")

worktree="${args[0]}"
branch="${args[1]}"

echo "Base: $base"
echo "Branch: $branch"
echo "Worktree: $worktree"

###### CREATE WORKTREE ######
if [[ -n "$(git branch --list "$branch")" ]]; then
  echo "Existing branch found: $branch"
  echo "Creating new worktree from existing branch: $branch"
  git worktree add "$worktree" "$branch"
else
  echo "No existing branch found"
  echo "Creating new worktree: $worktree linked to branch: $branch"
  git worktree add -b "$branch" "$worktree" ${base:+"$base"}
fi

# NOTE:
#   To check if branch is tracked: git config --get branch.ghfw.remote

###### SET UPSTREAM ######
pushd "$worktree" > /dev/null
if [[ -z "$(git ls-remote --heads origin "$branch")" ]]; then
  echo "Branch '$branch' does not exist on remote."
else
  echo "Branch '$branch' exists. Setting upstream."
  echo "Setting upstream branch to 'origin/$branch'" 
  git branch --set-upstream-to="origin/$branch"
fi
popd > /dev/null


echo "Finished."
