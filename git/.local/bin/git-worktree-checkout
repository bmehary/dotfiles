#!/bin/bash

set -Eeuo pipefail

# Reference: https://github.com/nicknisi/dotfiles/blob/main/bin/git-create-worktree


# TODO: Create a real usage for the script
usage() {
  cat <<EOF
Usage: $(basename "${BASH_SOURCE[0]}") [-h] [-v] [-b] [-B] [-p] <path>

Script the creation of a new worktree.

Available options:

-h, --help                    Print this help and exit
-v, --verbose                 Print script debug info
-b, --branch                  The branch to create
-B, --base                    The branch to use as the base for the new worktree (default: main)
-p, --prefix                  The prefix to apply to the branch name (default: $(git config github.user)/)
EOF
  exit
}

die() {
  local msg=$1
  local code=${2-1} # default exit status 1
  echo "$msg"
  exit "$code"
}


# Default values
base='origin/main'

while [[ "$#" -gt 0 ]]; do
    case "${1-}" in
        -h|--help) usage ;;
        -v|--verbose) set -x ;;
        -B|--base)
            base="${2-}"
            shift
            ;;
        -*) die "Error: Unknown option ${1-}" ;;
        *) 
            POSITIONAL_ARGS+=("${1-}")
            ;;
    esac
    shift
done

set -- "${POSITIONAL_ARGS[@]}"

args=("$@")

# check required params and arguments
[[ ${#args[@]} -lt 2 ]] && die "Too few script arguments"
[[ ${#args[@]} -gt 2 ]] && die "Too many script arguments"

worktree="${args[0]}"
branch="${args[1]}"

echo "Base: $base"
echo "Branch: $branch"
echo "Worktree: $worktree"

###### CREATE WORKTREE ######
if [[ -n "$(git branch --list "$branch")" ]]; then
  echo "Existing branch found: $branch"
  echo "Generating new worktree from existing branch: $branch"
  git worktree add "$worktree" "$branch"
else
  echo "No existing branch found"
  echo "Generating new worktree: $worktree"
  git worktree add -b "$branch" "$worktree" "$base"
fi

###### SET UPSTREAM ######
pushd "$worktree" > /dev/null
if [[ -z "$(git ls-remote --heads origin "$branch")" ]]; then
    echo "Branch '$branch' does not exist on remote."
else
    echo "Branch '$branch' exists. Setting upstream."
    echo "Setting upstream branch to 'origin/$branch'" 
    git branch --set-upstream-to="origin/$branch"
fi
popd > /dev/null


echo "Finished."
