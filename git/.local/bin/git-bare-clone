#!/usr/bin/env zsh

# References:
# Nick Nisi
#   https://nicknisi.com/posts/git-worktrees/
#   https://www.youtube.com/watch?v=VMJ1eAj5HgI

# Cugerone.com
#   https://morgan.cugerone.com/blog/workarounds-to-git-worktree-using-bare-repository-and-cannot-fetch-remote-branches/


# TODO: Handle parameters better.
# maybe use getopt or $@ instead of hard coding $1

repo="$1"
location='.bare'

echo "Creating Bare Repo..."

git clone --bare "$repo" "$location"
echo "gitdir: $location" > .git

echo "Adjusting origin fetch locations..."
pushd "$location" > /dev/null
git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*" 
popd > /dev/null

git fetch origin

echo "Finished."
