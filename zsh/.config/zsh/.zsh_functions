# Helper functions for zsh configuration
 
ismacos() {
	[[ $OSTYPE = *darwin* ]] || return 1
}

paths() {
    echo $PATH | tr ':' '\n'
    # echo ${PATH//:/\\n}
}

fpaths() {
    echo $FPATH | tr ':' '\n'
}

update_antidote_bundle() {
    local zsh_plugins_list="$1"
    local zsh_plugins_out="$2"

    if [[ ! ${zsh_plugins_out} -nt ${zsh_plugins_list} ]]; then
      (
        echo loading antidote and generating ${zsh_plugins_out}...
        source ${HOMEBREW_PREFIX}/opt/antidote/share/antidote/antidote.zsh
        antidote bundle <${zsh_plugins_list} >${zsh_plugins_out}
      )
    fi  
}