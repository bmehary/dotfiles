# Config reference - https://ghostty.org/docs/config

# Default configs: ghostty +show-config --default --docs
# List key bindings: ghostty +list-keybinds

# Default reload configs 
    ## macos: cmd+shift+,
    ## linux: ctrl+shift+,

# LEADER KEY: CTRL + F  (Note: there's not leader key in ghostty)


### KEY BINDINGS ###

# Reload config: LEADER + r
keybind = ctrl+a>r=reload_config

# Tab management 
keybind = ctrl+a>c=new_tab
keybind = ctrl+a>x=close_tab
keybind = ctrl+a>p=previous_tab
keybind = ctrl+a>n=next_tab

# split pane vertical
keybind = ctrl+a>\=new_split:right

# split pane horizontal
keybind = ctrl+a>-=new_split:down

# select panes with vi motion
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>j=goto_split:bottom 
keybind = ctrl+a>k=goto_split:top
keybind = ctrl+a>l=goto_split:right

# resize panes with vi motion using shift
keybind = ctrl+a>shift+h=resize_split:left,10
keybind = ctrl+a>shift+j=resize_split:down,10
keybind = ctrl+a>shift+k=resize_split:up,10
keybind = ctrl+a>shift+l=resize_split:right,10

# maximize current pae
keybind = ctrl+a>m=toggle_split_zoom
